# RecruitFlow AI — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to git.

# ========================
# Flask Backend Settings
# ========================
FLASK_APP=backend/run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=recruitflow-dev-secret-change-in-production
PORT=5000

# ========================
# Supabase (PostgreSQL)
# ========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ========================
# Google Gemini AI
# ========================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-1.5-flash

# ========================
# Resend Email API
# ========================
RESEND_API_KEY=re_your-resend-api-key

# ========================
# Google Calendar (optional)
# ========================
# Leave blank to use auto-generated calendar links
GOOGLE_CALENDAR_CREDENTIALS=

# ========================
# n8n Webhooks (optional)
# ========================
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ========================
# Frontend (Next.js)
# ========================
# Set this in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
